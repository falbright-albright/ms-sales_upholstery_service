# ---------------------------------------------------------------------------
# Environment configuration — copy this file to .env.local for local
# development, and set the same keys in Netlify (Site configuration →
# Environment variables) for production/preview deploys.
#
# Nothing in this file is a real credential. Values prefixed NEXT_PUBLIC_
# are bundled into client-side JavaScript and are visible to website
# visitors — never put a secret behind a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# The production URL of this website. Used to build canonical URLs,
# sitemap.xml, robots.txt, and Open Graph/Twitter metadata.
NEXT_PUBLIC_SITE_URL=https://www.example-upholstery-stc.ca

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion ID, if/when running paid search campaigns
# (format: AW-XXXXXXXXX). Leave unset if not running Google Ads.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Search Console / site-verification meta tag content, used to
# verify domain ownership without adding a file to /public.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to "true" only in local/staging environments to surface small
# on-page notices marking content that still needs the owner's input
# (hours, address, bio, etc). Must be unset or "false" in production —
# see src/components/ui/AdminNote.tsx.
NEXT_PUBLIC_SHOW_PLACEHOLDER_NOTICES=false
